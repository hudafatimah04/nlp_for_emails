GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
# Comma-separated sender email addresses.
ALLOWED_SENDERS=
ATTACHMENT_DIR=attachments
# Whole number of seconds.
POLL_INTERVAL_SECONDS=
BACKEND_API_URL=
BACKEND_MODE=mock
BACKEND_OUTBOX_DIR=backend_outbox
# Optional bearer token, supplied through the environment.
BACKEND_API_TOKEN=
# Optional executable path if Tesseract is not on PATH.
TESSERACT_CMD=
PROCESSED_DB_PATH=processed_emails.db
GEMINI_API_KEY=
# Optional Gemini model override.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
# auto tries Gemini first; gemini and groq select one provider only.
LLM_PROVIDER=auto
GEMINI_REQUEST_LIMIT=3
GROQ_REQUEST_LIMIT=3
# Local process guardrails. Lower them if your account has smaller quotas.
GEMINI_REQUESTS_PER_MINUTE=3
GEMINI_REQUESTS_PER_DAY=20
GROQ_REQUESTS_PER_MINUTE=30
GROQ_REQUESTS_PER_DAY=1000
LLM_PROVIDER_COOLDOWN_SECONDS=60
# Optional shared timeout override in seconds (defaults to 60 for Groq).
LLM_TIMEOUT_SECONDS=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_COMPLETION_TOKENS=3072

# Managed runtime retention. Review and pending handoff artifacts are retained.
TEMP_RETENTION_HOURS=24
FAILED_RETENTION_DAYS=30
LOG_RETENTION_DAYS=14
